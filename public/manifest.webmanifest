{
  "name": "Media Manager 621",
  "short_name": "MM 621",
  "description": "Media Manager 621 is an offline-first luxury file and media organizer. Import, browse, preview, organize and share photos, videos, music, documents and archives with optional device folder access.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0A0B",
  "theme_color": "#0A0A0B",
  "lang": "en-US",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Library",
      "short_name": "Library",
      "description": "Browse your local media library",
      "url": "./?place=internal",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse Photos",
      "short_name": "Photos",
      "description": "View your imported photos",
      "url": "./?place=photos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Play Videos",
      "short_name": "Videos",
      "description": "Browse and play your videos",
      "url": "./?place=videos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Listen to Music",
      "short_name": "Music",
      "description": "Browse your audio library",
      "url": "./?place=music",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*",
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".gif",
          ".webp",
          ".svg"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".ogg"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".flac",
          ".m4a"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/zip": [
          ".zip"
        ],
        "text/*": [
          ".txt",
          ".md",
          ".json",
          ".csv"
        ]
      }
    }
  ],
  "dir": "ltr",
  "display_override": [
    "standalone"
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "screenshots/media-manager-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Media Manager 621 desktop library"
    },
    {
      "src": "screenshots/media-manager-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Media Manager 621 mobile library"
    }
  ]
}
