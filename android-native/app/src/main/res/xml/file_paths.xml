<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only app-owned cache/files are shareable. Never expose the entire external drive. -->
    <cache-path name="share-cache" path="shared/" />
    <files-path name="share-files" path="shared/" />
    <external-files-path name="app-external-files" path="shared/" />
</paths>